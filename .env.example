# ─────────────────────────────────────────────────────────────────────────────
# Raaz MD — Admin Dashboard environment
#
# Talks to the SAME Zoho CRM as the doctor dashboard. Needs a token that can read
# (COQL) and write the Doctors module (to set Login_Id / Password_Hash).
# Copy to `.env.local` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# Zoho self-client OAuth (India DC shown). Reuse the doctor dashboard's values.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=              # read-scoped (ZohoCRM.modules.READ + ZohoCRM.coql.READ)
ZOHO_WRITE_REFRESH_TOKEN=        # full-access (ZohoCRM.modules.ALL + ZohoCRM.coql.READ) — used for writes
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_API_VERSION=v8
